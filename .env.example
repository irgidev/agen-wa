# WhatsApp Business Cloud API (Meta) — see README "Setup Part A"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
WHATSAPP_APP_SECRET=

# LLM layer (model-agnostic). rule-based mode needs no key.
LLM_PROVIDER=rule-based   # rule-based | openai-compatible | gemini | ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Services
WEBHOOK_PORT=8000
MOCK_SERVICE_URL=http://mock-service:8001
OPERATOR_CONSOLE_PORT=8002

# Governance
LOAN_APPROVAL_THRESHOLD_IDR=10000000

# Audit
AUDIT_LOG_PATH=./audit/audit.jsonl
